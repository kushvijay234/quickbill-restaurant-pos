{
  "expo": {
    "name": "QuickBill POS",
    "slug": "quickbill-restaurant-pos",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "quickbill",
    "splash": {
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quickbill.restaurantpos"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.quickbill.restaurantpos"
    },
    "plugins": [
      "expo-sharing",
      "expo-font"
    ]
  }
}
